diff --git a/main/src/Screens/Agenda/AgendaScreen.cpp b/main/src/Screens/Agenda/AgendaScreen.cpp
new file mode 100644
index 0000000..7322e1e
--- /dev/null
+++ b/main/src/Screens/Agenda/AgendaScreen.cpp
@@ -0,0 +1,271 @@
+#include "AgendaScreen.h"
+#include "Calendar/CalendarStore.h"
+#include "Screens/MainMenu/MainMenu.h"
+#include "Devices/Input.h"
+#include "Services/Time.h"
+#include "Notifs/Phone.h"
+#include "Util/Services.h"
+#include "Theme/theme.h"
+#include "Calendar/CalendarUi.h"
+#include <cstdio>
+#include <ctime>
+
+static const lv_color_t ColText = lv_color_white();
+static const lv_color_t ColDay = lv_color_make(0xff, 0x8a, 0x00);
+static const lv_color_t ColNow = lv_color_make(0x4c, 0xd9, 0x64);
+static const lv_color_t ColDim = lv_color_make(0x90, 0x90, 0x90);
+
+static int64_t nowLocal(){
+	return calNowLocal();
+}
+
+static Phone* phone(){
+	return (Phone*) Services.get(Service::Phone);
+}
+
+AgendaScreen::AgendaScreen() : queue(4){
+	lv_obj_set_size(*this, 128, 128);
+	lv_obj_set_style_bg_color(*this, lv_color_black(), 0);
+	lv_obj_set_style_bg_opa(*this, LV_OPA_COVER, 0);
+
+	header = lv_label_create(*this);
+	lv_obj_set_style_text_font(header, &devin, 0);
+	lv_obj_set_style_text_color(header, ColDay, 0);
+	lv_obj_set_pos(header, 4, 2);
+
+	list = lv_obj_create(*this);
+	lv_obj_set_pos(list, 0, 16);
+	lv_obj_set_size(list, 128, 112);
+	lv_obj_set_style_bg_opa(list, LV_OPA_TRANSP, 0);
+	lv_obj_set_style_border_width(list, 0, 0);
+	lv_obj_set_style_radius(list, 0, 0);
+	lv_obj_set_style_pad_all(list, 3, 0);
+	lv_obj_set_style_pad_row(list, 2, 0);
+	lv_obj_set_flex_flow(list, LV_FLEX_FLOW_COLUMN);
+	lv_obj_set_scrollbar_mode(list, LV_SCROLLBAR_MODE_OFF);
+}
+
+AgendaScreen::~AgendaScreen() = default;
+
+void AgendaScreen::onStart(){
+	Events::listen(Facility::Input, &queue);
+}
+
+void AgendaScreen::onStop(){
+	Events::unlisten(&queue);
+}
+
+lv_obj_t* AgendaScreen::addLabel(const char* text, lv_color_t color){
+	auto label = lv_label_create(list);
+	lv_obj_set_width(label, 120);
+	lv_label_set_long_mode(label, LV_LABEL_LONG_WRAP);
+	lv_obj_set_style_text_font(label, &devin, 0);
+	lv_obj_set_style_text_color(label, color, 0);
+	lv_label_set_text(label, text);
+	return label;
+}
+
+// ---- agenda ----------------------------------------------------------------------------------
+
+void AgendaScreen::showAgenda(int64_t now){
+	mode = Mode::Agenda;
+	auto& store = CalendarStore::get();
+	shownRev = store.revision();
+	shownMinute = now / 60;
+
+	lv_label_set_text(header, "AGENDA");
+	lv_obj_clean(list);
+	rows.clear();
+	lv_obj_scroll_to_y(list, 0, LV_ANIM_OFF);
+
+	const auto events = store.upcoming(now, MaxShown);
+	if(events.empty()){
+		addLabel("No upcoming events.\n\nClick the wheel for\nactions and sync.", ColDim);
+		return;
+	}
+
+	char buf[96];
+	char t0[8], t1[8];
+	int lastYday = -1, lastYear = -1;
+
+	for(const auto& e : events){
+		const time_t start = (time_t) e.start, end = (time_t) e.end;
+		tm ts = {}, te = {};
+		gmtime_r(&start, &ts);
+		gmtime_r(&end, &te);
+
+		if(ts.tm_yday != lastYday || ts.tm_year != lastYear){
+			const bool first = lastYday == -1;
+			lastYday = ts.tm_yday;
+			lastYear = ts.tm_year;
+			strftime(buf, sizeof(buf), "%a %d %b", &ts);
+			auto header = addLabel(buf, ColDay);
+			if(!first) lv_obj_set_style_pad_top(header, 9, 0);   // an empty line between days
+		}
+
+		const char* mark = e.cancelled ? "x " : "";
+		if(e.allDay){
+			snprintf(buf, sizeof(buf), "%sall day %s", mark, e.title.c_str());
+		}else{
+			strftime(t0, sizeof(t0), "%H:%M", &ts);
+			strftime(t1, sizeof(t1), "%H:%M", &te);
+			snprintf(buf, sizeof(buf), "%s%s-%s %s", mark, t0, t1, e.title.c_str());
+		}
+		addLabel(buf, e.cancelled ? ColDim : e.start <= now ? ColNow : ColText);
+
+		if(!e.location.empty()){
+			snprintf(buf, sizeof(buf), "  @ %s", e.location.c_str());
+			addLabel(buf, ColDim);
+		}
+	}
+}
+
+// ---- menus -----------------------------------------------------------------------------------
+
+void AgendaScreen::showMenu(const char* title, const std::vector<std::string>& items){
+	lv_label_set_text(header, title);
+	lv_obj_clean(list);
+	rows.clear();
+	selected = 0;
+
+	for(const auto& item : items){
+		auto row = addLabel(item.c_str(), ColText);
+		lv_label_set_long_mode(row, LV_LABEL_LONG_DOT);
+		lv_obj_set_style_pad_hor(row, 2, 0);
+		lv_obj_set_style_pad_ver(row, 1, 0);
+		lv_obj_set_style_bg_color(row, ColDay, 0);
+		rows.push_back(row);
+	}
+	moveSelection(0);
+}
+
+void AgendaScreen::moveSelection(int delta){
+	if(rows.empty()) return;
+	selected = (selected + delta + (int) rows.size()) % (int) rows.size();
+	for(int i = 0; i < (int) rows.size(); i++){
+		const bool sel = i == selected;
+		lv_obj_set_style_bg_opa(rows[i], sel ? LV_OPA_COVER : LV_OPA_TRANSP, 0);
+		lv_obj_set_style_text_color(rows[i], sel ? lv_color_black() : ColText, 0);
+	}
+	lv_obj_scroll_to_view(rows[selected], LV_ANIM_ON);
+}
+
+void AgendaScreen::showActions(){
+	mode = Mode::Actions;
+	actions.clear();
+	std::vector<std::string> items;
+
+	auto& store = CalendarStore::get();
+	if(!store.templates().empty()){
+		actions.push_back(Action::StartTask);
+		items.emplace_back("Start task...");
+	}
+	if(auto cur = store.current(nowLocal())){
+		actions.push_back(Action::Finish);
+		items.emplace_back("Finish: " + cur->title);
+		actions.push_back(Action::Cancel);
+		items.emplace_back("Cancel: " + cur->title);
+	}
+	actions.push_back(Action::Sync);
+	items.emplace_back("Sync with phone");
+
+	showMenu("ACTIONS", items);
+}
+
+void AgendaScreen::showTemplates(){
+	mode = Mode::Templates;
+	templateIds.clear();
+	std::vector<std::string> items;
+
+	for(const auto& t : CalendarStore::get().templates()){
+		templateIds.push_back(t.id);
+		char dur[16];
+		if(t.durationMin % 60 == 0) snprintf(dur, sizeof(dur), " %uh", (unsigned) (t.durationMin / 60));
+		else snprintf(dur, sizeof(dur), " %um", (unsigned) t.durationMin);
+		items.push_back(t.title + dur);
+	}
+	showMenu("START TASK", items);
+}
+
+void AgendaScreen::activate(){
+	if(mode == Mode::Actions){
+		if(selected < 0 || selected >= (int) actions.size()) return;
+		switch(actions[selected]){
+			case Action::StartTask:
+				showTemplates();
+				return;
+			case Action::Finish:
+				if(CalendarStore::get().finishCurrent(nowLocal())){
+					if(auto p = phone()) p->calendarFlush();
+				}
+				break;
+			case Action::Cancel:
+				if(auto cur = CalendarStore::get().current(nowLocal())){
+					if(CalendarStore::get().setStatus(cur->id, true)){
+						if(auto p = phone()) p->calendarFlush();
+					}
+				}
+				break;
+			case Action::Sync:
+				if(auto p = phone()) p->calendarSync();
+				break;
+		}
+		showAgenda(nowLocal());
+	}else if(mode == Mode::Templates){
+		if(selected < 0 || selected >= (int) templateIds.size()) return;
+		if(CalendarStore::get().startTask(templateIds[selected], nowLocal())){
+			if(auto p = phone()) p->calendarFlush();
+		}
+		showAgenda(nowLocal());
+	}
+}
+
+// ---- input -----------------------------------------------------------------------------------
+
+void AgendaScreen::onButton(uint8_t btn){
+	switch(btn){
+		case Input::Up:
+			if(mode == Mode::Agenda) lv_obj_scroll_by(list, 0, ScrollStep, LV_ANIM_ON);
+			else moveSelection(-1);
+			break;
+		case Input::Down:
+			if(mode == Mode::Agenda) lv_obj_scroll_by(list, 0, -ScrollStep, LV_ANIM_ON);
+			else moveSelection(1);
+			break;
+		case Input::Select:
+			if(mode == Mode::Agenda) showActions();
+			else activate();
+			break;
+		case Input::Alt:
+			if(mode == Mode::Templates) showActions();
+			else if(mode == Mode::Actions) showAgenda(nowLocal());
+			else transition([](){ return std::make_unique<MainMenu>(); });
+			break;
+		default:
+			break;
+	}
+}
+
+void AgendaScreen::loop(){
+	if(mode == Mode::Agenda){
+		// Rebuild when the phone pushed new data, and once a minute so finished events drop off
+		const int64_t now = nowLocal();
+		if(CalendarStore::get().revision() != shownRev || now / 60 != shownMinute){
+			showAgenda(now);
+		}
+	}
+
+	Event evt{};
+	if(!queue.get(evt, 0)) return;
+
+	if(evt.facility == Facility::Input){
+		auto data = (Input::Data*) evt.data;
+		const bool press = data->action == Input::Data::Press;
+		const uint8_t btn = (uint8_t) data->btn;
+		free(evt.data);
+		if(press) onButton(btn);   // may transition away, so evt.data is freed first
+		return;
+	}
+
+	free(evt.data);
+}
