+#ifndef ARTEMIS_FIRMWARE_NIGHTMODE_H
+#define ARTEMIS_FIRMWARE_NIGHTMODE_H
+
+#include "Services/Time.h"
+#include "Util/Services.h"
+#include <ctime>
+
+// Night mode: LEDs off and minimum screen brightness between StartHour and EndHour (local time).
+// The saved settings are not touched, so everything returns to normal in the morning.
+namespace NightMode {
+constexpr int StartHour = 22;
+constexpr int EndHour = 6;
+
+inline bool active(){
+	auto ts = (Time*) Services.get(Service::Time);
+	if(ts == nullptr) return false;
+	const tm t = ts->getTime();
+	if(t.tm_year + 1900 < 2024) return false;   // clock not set by a phone yet
+	return t.tm_hour >= StartHour || t.tm_hour < EndHour;
+}
+}
+
+#endif //ARTEMIS_FIRMWARE_NIGHTMODE_H
