diff --git a/main/src/Calendar/CalendarReminders.cpp b/main/src/Calendar/CalendarReminders.cpp
new file mode 100644
index 0000000..82f89f1
--- /dev/null
+++ b/main/src/Calendar/CalendarReminders.cpp
@@ -0,0 +1,76 @@
+#include "CalendarReminders.h"
+#include "CalendarStore.h"
+#include "Notifs/Phone.h"
+#include "Services/Time.h"
+#include "Util/Services.h"
+#include "NightMode.h"
+#include "Services/StatusCenter.h"
+#include "Services/BacklightBrightness.h"
+#include "Settings/Settings.h"
+#include <cstdio>
+#include <ctime>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+static Notif toNotif(const CalEvent& e){
+	char when[48];
+	if(e.allDay){
+		snprintf(when, sizeof(when), "All day");
+	}else{
+		const time_t s = (time_t) e.start, en = (time_t) e.end;
+		tm ts = {}, te = {};
+		gmtime_r(&s, &ts);
+		gmtime_r(&en, &te);
+		snprintf(when, sizeof(when), "%02d:%02d-%02d:%02d", ts.tm_hour, ts.tm_min, te.tm_hour, te.tm_min);
+	}
+
+	std::string msg = when;
+	if(!e.location.empty()) msg += " @ " + e.location;
+
+	return Notif{
+		.uid = Phone::LocalNotifBit | (e.id & ~Phone::LocalNotifBit),
+		.title = e.title,
+		.message = msg,
+		.appID = "Calendar",
+		.category = Notif::Category::Schedule,
+	};
+}
+
+static void applyNightMode(bool night){
+	if(auto status = (StatusCenter*) Services.get(Service::Status)) status->updateLED();
+	auto bl = (BacklightBrightness*) Services.get(Service::Backlight);
+	auto settings = (Settings*) Services.get(Service::Settings);
+	if(bl != nullptr && settings != nullptr && bl->isOn()){
+		bl->setBrightness(night ? 0 : settings->get().screenBrightness);
+	}
+}
+
+static void reminderTask(void*){
+	vTaskDelay(pdMS_TO_TICKS(5000));
+	bool night = false;
+	while(true){
+		// Night mode (22:00-06:00): switch LEDs and brightness the moment the hour flips
+		if(NightMode::active() != night){
+			night = !night;
+			applyNightMode(night);
+		}
+
+		auto ts = (Time*) Services.get(Service::Time);
+		auto phone = (Phone*) Services.get(Service::Phone);
+		if(ts != nullptr && phone != nullptr){
+			tm t = ts->getTime();
+			if(t.tm_year + 1900 >= 2024){                  // clock was set by a phone at least once
+				const int64_t now = (int64_t) mktime(&t);  // device TZ is UTC -> "local epoch"
+				for(const auto& e : CalendarStore::get().dueReminders(now)){
+					CalendarStore::get().pushAlert(e, now);   // full-screen alert, picked up by the lock screen
+					phone->addLocal(toNotif(e));              // beep + wake + entry in the notification list
+				}
+			}
+		}
+		vTaskDelay(pdMS_TO_TICKS(15000));
+	}
+}
+
+void CalendarReminders::start(){
+	xTaskCreate(reminderTask, "CalRemind", 4096, nullptr, 3, nullptr);
+}
diff --git a/main/src/Calendar/CalendarReminders.h b/main/src/Calendar/CalendarReminders.h
new file mode 100644
index 0000000..65a5025
--- /dev/null
+++ b/main/src/Calendar/CalendarReminders.h
@@ -0,0 +1,10 @@
+#ifndef ARTEMIS_FIRMWARE_CALENDARREMINDERS_H
+#define ARTEMIS_FIRMWARE_CALENDARREMINDERS_H
+
+// Background task: every 15 s checks CalendarStore and raises reminders as local
+// watch notifications, so they fire even when the phone is out of range.
+namespace CalendarReminders {
+void start();
+}
+
+#endif //ARTEMIS_FIRMWARE_CALENDARREMINDERS_H
diff --git a/main/src/Calendar/CalendarStore.cpp b/main/src/Calendar/CalendarStore.cpp
new file mode 100644
index 0000000..9b03437
--- /dev/null
+++ b/main/src/Calendar/CalendarStore.cpp
@@ -0,0 +1,383 @@
+#include "CalendarStore.h"
+#include <algorithm>
+#include <cstdio>
+#include <esp_log.h>
+
+static const char* TAG = "Calendar";
+
+static void clip(std::string& s, size_t max){
+	if(s.size() > max) s.resize(max);
+}
+
+static bool byStart(const CalEvent& a, const CalEvent& b){
+	return a.start < b.start;
+}
+
+CalendarStore& CalendarStore::get(){
+	static CalendarStore instance;
+	return instance;
+}
+
+CalendarStore::CalendarStore(){
+	events.reserve(MaxEvents);
+	load();
+}
+
+int64_t CalendarStore::reminderAt(const CalEvent& e){
+	if(e.allDay) return e.start + 9 * 3600;
+	return e.start - (int64_t) e.remindMin * 60;
+}
+
+// ---- phone sync ------------------------------------------------------------------------------
+
+void CalendarStore::beginSync(){
+	std::lock_guard lock(mtx);
+	staging.clear();
+	staging.reserve(MaxEvents);
+	syncing = true;
+}
+
+void CalendarStore::stage(const CalEvent& ev){
+	std::lock_guard lock(mtx);
+	if(!syncing || staging.size() >= MaxEvents) return;
+	CalEvent e = ev;
+	clip(e.title, MaxTitle);
+	clip(e.location, MaxLocation);
+	staging.push_back(std::move(e));
+}
+
+void CalendarStore::commitSync(){
+	{
+		std::lock_guard lock(mtx);
+		if(!syncing) return;
+		syncing = false;
+
+		// Keep tasks started on the watch until the phone confirms them...
+		for(const auto& e : events){
+			if((e.id & LocalIdBit) && hasPendingStart(e.id) && staging.size() < MaxEvents){
+				staging.push_back(e);
+			}
+		}
+		// ...and keep finishes / cancels the phone hasn't processed yet
+		for(const auto& p : pend){
+			for(auto& e : staging){
+				if(e.id != p.eventId) continue;
+				if(p.type == PendingAction::Type::End) e.end = std::max(p.time, e.start + 60);
+				else if(p.type == PendingAction::Type::Status) e.cancelled = p.status == 1;
+			}
+		}
+
+		events.swap(staging);
+		staging.clear();
+		staging.shrink_to_fit();
+		std::sort(events.begin(), events.end(), byStart);
+		save();
+		ESP_LOGI(TAG, "Sync committed, %u events", (unsigned) events.size());
+	}
+	rev++;
+}
+
+void CalendarStore::remove(uint32_t id){
+	{
+		std::lock_guard lock(mtx);
+		const auto before = events.size();
+		std::erase_if(events, [id](const CalEvent& e){ return e.id == id; });
+		if(events.size() == before) return;
+		save();
+	}
+	rev++;
+}
+
+void CalendarStore::beginTemplates(){
+	std::lock_guard lock(mtx);
+	tplStaging.clear();
+	tplSyncing = true;
+}
+
+void CalendarStore::stageTemplate(const TaskTemplate& tpl){
+	std::lock_guard lock(mtx);
+	if(!tplSyncing || tplStaging.size() >= MaxTemplates) return;
+	TaskTemplate t = tpl;
+	clip(t.title, MaxTitle);
+	if(t.durationMin == 0) t.durationMin = 30;
+	tplStaging.push_back(std::move(t));
+}
+
+void CalendarStore::commitTemplates(){
+	{
+		std::lock_guard lock(mtx);
+		if(!tplSyncing) return;
+		tplSyncing = false;
+		tpls.swap(tplStaging);
+		tplStaging.clear();
+		save();
+	}
+	rev++;
+}
+
+void CalendarStore::ack(uint32_t seq){
+	std::lock_guard lock(mtx);
+	const auto before = pend.size();
+	std::erase_if(pend, [seq](const PendingAction& p){ return p.seq == seq; });
+	if(pend.size() != before) save();
+}
+
+bool CalendarStore::hasPendingStart(uint32_t eventId) const{
+	return std::any_of(pend.begin(), pend.end(), [eventId](const PendingAction& p){
+		return p.type == PendingAction::Type::Start && p.eventId == eventId;
+	});
+}
+
+// ---- queries ---------------------------------------------------------------------------------
+
+std::vector<CalEvent> CalendarStore::upcoming(int64_t nowLocal, size_t max) const{
+	std::lock_guard lock(mtx);
+	std::vector<CalEvent> out;
+	out.reserve(std::min(max, events.size()));
+	for(const auto& e : events){
+		if(e.end <= nowLocal) continue;
+		out.push_back(e);
+		if(out.size() >= max) break;
+	}
+	return out;
+}
+
+const CalEvent* CalendarStore::currentLocked(int64_t nowLocal) const{
+	const CalEvent* best = nullptr;
+	for(const auto& e : events){
+		if(e.allDay || e.cancelled || e.start > nowLocal || e.end <= nowLocal) continue;
+		if(best == nullptr || e.start >= best->start) best = &e;
+	}
+	return best;
+}
+
+std::optional<CalEvent> CalendarStore::current(int64_t nowLocal) const{
+	std::lock_guard lock(mtx);
+	const auto* e = currentLocked(nowLocal);
+	if(e == nullptr) return std::nullopt;
+	return *e;
+}
+
+std::vector<TaskTemplate> CalendarStore::templates() const{
+	std::lock_guard lock(mtx);
+	return tpls;
+}
+
+std::vector<PendingAction> CalendarStore::pending() const{
+	std::lock_guard lock(mtx);
+	return pend;
+}
+
+// ---- watch actions ---------------------------------------------------------------------------
+
+bool CalendarStore::startTask(uint32_t tplId, int64_t nowLocal){
+	{
+		std::lock_guard lock(mtx);
+		auto tpl = std::find_if(tpls.begin(), tpls.end(), [tplId](const TaskTemplate& t){ return t.id == tplId; });
+		if(tpl == tpls.end() || pend.size() >= MaxPending) return false;
+
+		CalEvent e;
+		e.id = LocalIdBit | (nextLocalId++ & ~LocalIdBit);
+		e.start = nowLocal;
+		e.end = nowLocal + (int64_t) tpl->durationMin * 60;
+		e.title = tpl->title;
+		e.icon = tpl->icon;
+		e.color = tpl->color;
+
+		if(events.size() >= MaxEvents){
+			// drop the furthest-away event; the phone will push the full set again
+			events.erase(std::max_element(events.begin(), events.end(), byStart));
+		}
+		events.push_back(e);
+		std::sort(events.begin(), events.end(), byStart);
+
+		pend.push_back({ PendingAction::Type::Start, nextSeq++, e.id, tplId, nowLocal });
+		save();
+	}
+	rev++;
+	return true;
+}
+
+bool CalendarStore::finishCurrent(int64_t nowLocal){
+	{
+		std::lock_guard lock(mtx);
+		if(pend.size() >= MaxPending) return false;
+		const auto* cur = currentLocked(nowLocal);
+		if(cur == nullptr) return false;
+
+		auto& e = const_cast<CalEvent&>(*cur);
+		e.end = std::max(nowLocal, e.start + 60);
+		pend.push_back({ PendingAction::Type::End, nextSeq++, e.id, 0, e.end });
+		save();
+	}
+	rev++;
+	return true;
+}
+
+bool CalendarStore::setStatus(uint32_t eventId, bool cancelled){
+	{
+		std::lock_guard lock(mtx);
+		if(pend.size() >= MaxPending) return false;
+		auto e = std::find_if(events.begin(), events.end(), [eventId](const CalEvent& ev){ return ev.id == eventId; });
+		if(e == events.end()) return false;
+		e->cancelled = cancelled;
+		PendingAction p;
+		p.type = PendingAction::Type::Status;
+		p.seq = nextSeq++;
+		p.eventId = eventId;
+		p.status = cancelled ? 1 : 0;
+		pend.push_back(p);
+		save();
+	}
+	rev++;
+	return true;
+}
+
+void CalendarStore::pushAlert(const CalEvent& e, int64_t nowLocal){
+	std::lock_guard lock(mtx);
+	if(alerts.size() >= 4) alerts.erase(alerts.begin());
+	alerts.emplace_back(e, nowLocal);
+}
+
+std::optional<CalEvent> CalendarStore::takeAlert(int64_t nowLocal){
+	std::lock_guard lock(mtx);
+	while(!alerts.empty()){
+		auto [e, at] = alerts.front();
+		alerts.erase(alerts.begin());
+		if(nowLocal - at <= 10 * 60) return e;
+	}
+	return std::nullopt;
+}
+
+std::vector<CalEvent> CalendarStore::dueReminders(int64_t nowLocal){
+	std::lock_guard lock(mtx);
+	std::vector<CalEvent> out;
+
+	// First run, clock moved backwards, or a long gap: don't replay old reminders
+	if(lastReminderCheck == 0 || nowLocal < lastReminderCheck){
+		lastReminderCheck = nowLocal;
+		return out;
+	}
+	const int64_t since = std::max(lastReminderCheck, nowLocal - 15 * 60);
+
+	for(const auto& e : events){
+		if(e.remindMin < 0 || e.cancelled) continue;
+		const int64_t at = reminderAt(e);
+		if(at > since && at <= nowLocal) out.push_back(e);
+	}
+	lastReminderCheck = nowLocal;
+	return out;
+}
+
+// ---- persistence -----------------------------------------------------------------------------
+
+namespace {
+struct Writer {
+	FILE* f;
+	template<typename T> void put(const T& v){ fwrite(&v, sizeof(T), 1, f); }
+	void str(const std::string& s){
+		const uint8_t n = std::min<size_t>(s.size(), 255);
+		put(n);
+		fwrite(s.data(), 1, n, f);
+	}
+};
+
+struct Reader {
+	FILE* f;
+	bool ok = true;
+	template<typename T> void get(T& v){ if(ok && fread(&v, sizeof(T), 1, f) != 1) ok = false; }
+	void str(std::string& s){
+		uint8_t n = 0;
+		get(n);
+		if(!ok) return;
+		s.resize(n);
+		if(n && fread(s.data(), 1, n, f) != n) ok = false;
+	}
+};
+}
+
+void CalendarStore::load(){
+	FILE* f = fopen(Path, "rb");
+	if(f == nullptr) return;
+	Reader r{ f };
+
+	uint32_t magic = 0;
+	r.get(magic);
+	if(!r.ok || magic != Magic){
+		fclose(f);
+		ESP_LOGW(TAG, "Ignoring old or invalid %s", Path);
+		return;
+	}
+	r.get(nextSeq);
+	r.get(nextLocalId);
+
+	uint32_t count = 0;
+	r.get(count);
+	for(uint32_t i = 0; r.ok && i < std::min<uint32_t>(count, MaxEvents); i++){
+		CalEvent e;
+		uint8_t allDay = 0;
+		uint8_t cancelled = 0;
+		r.get(e.id); r.get(e.start); r.get(e.end); r.get(allDay); r.get(e.remindMin);
+		r.get(e.icon); r.get(e.color); r.get(cancelled);
+		r.str(e.title); r.str(e.location);
+		e.allDay = allDay != 0;
+		e.cancelled = cancelled != 0;
+		if(r.ok) events.push_back(std::move(e));
+	}
+
+	r.get(count);
+	for(uint32_t i = 0; r.ok && i < std::min<uint32_t>(count, MaxTemplates); i++){
+		TaskTemplate t;
+		r.get(t.id); r.get(t.durationMin); r.get(t.icon); r.get(t.color); r.str(t.title);
+		if(r.ok) tpls.push_back(std::move(t));
+	}
+
+	r.get(count);
+	for(uint32_t i = 0; r.ok && i < std::min<uint32_t>(count, MaxPending); i++){
+		PendingAction p;
+		uint8_t type = 0;
+		r.get(type); r.get(p.seq); r.get(p.eventId); r.get(p.tplId); r.get(p.time); r.get(p.status);
+		p.type = type == 2 ? PendingAction::Type::Status : type == 1 ? PendingAction::Type::End : PendingAction::Type::Start;
+		if(r.ok) pend.push_back(p);
+	}
+
+	fclose(f);
+	ESP_LOGI(TAG, "Loaded %u events, %u templates, %u pending", (unsigned) events.size(), (unsigned) tpls.size(), (unsigned) pend.size());
+}
+
+void CalendarStore::save(){
+	FILE* f = fopen(TmpPath, "wb");
+	if(f == nullptr){
+		ESP_LOGE(TAG, "Can't open %s for writing", TmpPath);
+		return;
+	}
+	Writer w{ f };
+
+	w.put(Magic);
+	w.put(nextSeq);
+	w.put(nextLocalId);
+
+	w.put((uint32_t) events.size());
+	for(const auto& e : events){
+		w.put(e.id); w.put(e.start); w.put(e.end); w.put((uint8_t) (e.allDay ? 1 : 0)); w.put(e.remindMin);
+		w.put(e.icon); w.put(e.color); w.put((uint8_t) (e.cancelled ? 1 : 0));
+		w.str(e.title); w.str(e.location);
+	}
+
+	w.put((uint32_t) tpls.size());
+	for(const auto& t : tpls){
+		w.put(t.id); w.put(t.durationMin); w.put(t.icon); w.put(t.color); w.str(t.title);
+	}
+
+	w.put((uint32_t) pend.size());
+	for(const auto& p : pend){
+		w.put((uint8_t) (p.type == PendingAction::Type::Status ? 2 : p.type == PendingAction::Type::End ? 1 : 0));
+		w.put(p.seq); w.put(p.eventId); w.put(p.tplId); w.put(p.time); w.put(p.status);
+	}
+
+	fclose(f);
+	::remove(Path);
+	if(rename(TmpPath, Path) != 0){
+		ESP_LOGE(TAG, "Rename %s -> %s failed", TmpPath, Path);
+	}
+}
diff --git a/main/src/Calendar/CalendarStore.h b/main/src/Calendar/CalendarStore.h
new file mode 100644
index 0000000..667a226
--- /dev/null
+++ b/main/src/Calendar/CalendarStore.h
@@ -0,0 +1,118 @@
+#ifndef ARTEMIS_FIRMWARE_CALENDARSTORE_H
+#define ARTEMIS_FIRMWARE_CALENDARSTORE_H
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Times use the Time service's "local epoch": unix seconds + the phone's UTC offset,
+// so they compare directly with Time::getTime() and format with gmtime_r().
+struct CalEvent {
+	uint32_t id = 0;          // phone ids are < 2^31; tasks started on the watch have LocalIdBit set
+	int64_t start = 0;
+	int64_t end = 0;
+	bool allDay = false;
+	int16_t remindMin = -1;   // -1 = no reminder
+	uint8_t icon = 0;         // TaskIcons id, 0 = none
+	uint32_t color = 0;       // 0xRRGGBB, 0 = default
+	bool cancelled = false;
+	std::string title;        // ASCII (phone transliterates; stock fonts cover 32..126 only)
+	std::string location;
+};
+
+struct TaskTemplate {
+	uint32_t id = 0;
+	uint16_t durationMin = 30;
+	uint8_t icon = 0;
+	uint32_t color = 0;
+	std::string title;
+};
+
+// Watch -> phone actions, kept (and persisted) until the phone acknowledges them,
+// so tasks started while the phone is away reach the phone on the next connection.
+struct PendingAction {
+	enum class Type : uint8_t { Start, End, Status } type = Type::Start;
+	uint32_t seq = 0;
+	uint32_t eventId = 0;     // Start: local id of the new event; End: id of the finished event
+	uint32_t tplId = 0;       // Start only
+	int64_t time = 0;         // Start: start time; End: end time
+	uint8_t status = 0;       // Status only: 0 = done, 1 = cancelled
+};
+
+class CalendarStore {
+public:
+	static constexpr uint32_t LocalIdBit = 0x80000000;
+	static constexpr size_t MaxEvents = 48;
+	static constexpr size_t MaxTemplates = 16;
+	static constexpr size_t MaxPending = 16;
+	static constexpr size_t MaxTitle = 40;
+	static constexpr size_t MaxLocation = 32;
+
+	static CalendarStore& get();
+
+	// ---- pushed by the phone ----
+	// Full agenda sync: calBegin -> calAdd x N -> calEnd. Live data is swapped only on commit.
+	void beginSync();
+	void stage(const CalEvent& ev);
+	void commitSync();
+	void remove(uint32_t id);
+
+	void beginTemplates();
+	void stageTemplate(const TaskTemplate& tpl);
+	void commitTemplates();
+
+	void ack(uint32_t seq);
+
+	// ---- queries ----
+	std::vector<CalEvent> upcoming(int64_t nowLocal, size_t max) const;
+	std::optional<CalEvent> current(int64_t nowLocal) const;   // latest-started timed event in progress
+	std::vector<TaskTemplate> templates() const;
+	std::vector<PendingAction> pending() const;
+	uint32_t revision() const { return rev.load(); }
+
+	// ---- actions on the watch ----
+	bool startTask(uint32_t tplId, int64_t nowLocal);
+	bool finishCurrent(int64_t nowLocal);
+	bool setStatus(uint32_t eventId, bool cancelled);
+
+	// Reminder alerts waiting to be shown full-screen (TaskAlertScreen).
+	void pushAlert(const CalEvent& e, int64_t nowLocal);
+	std::optional<CalEvent> takeAlert(int64_t nowLocal);   // drops alerts older than 10 min
+
+	// Events whose reminder time passed since the previous call (called ~every 15 s).
+	std::vector<CalEvent> dueReminders(int64_t nowLocal);
+
+	// All-day events remind at 09:00 of their day; timed ones remindMin before start.
+	static int64_t reminderAt(const CalEvent& e);
+
+private:
+	CalendarStore();
+
+	void load();
+	void save();                            // caller holds mtx
+	const CalEvent* currentLocked(int64_t nowLocal) const;
+	bool hasPendingStart(uint32_t eventId) const;
+
+	mutable std::mutex mtx;
+	std::vector<CalEvent> events;
+	std::vector<CalEvent> staging;
+	bool syncing = false;
+	std::vector<TaskTemplate> tpls;
+	std::vector<TaskTemplate> tplStaging;
+	bool tplSyncing = false;
+	std::vector<PendingAction> pend;
+	uint32_t nextSeq = 1;
+	uint32_t nextLocalId = 1;
+	int64_t lastReminderCheck = 0;
+	std::atomic<uint32_t> rev{ 1 };
+	std::vector<std::pair<CalEvent, int64_t>> alerts;
+
+	static constexpr const char* Path = "/spiffs/calendar.bin";
+	static constexpr const char* TmpPath = "/spiffs/calendar.tmp";
+	static constexpr uint32_t Magic = 0x334C4143; // "CAL3"
