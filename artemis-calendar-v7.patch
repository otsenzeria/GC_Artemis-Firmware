+#ifndef ARTEMIS_FIRMWARE_TASKFACE_H
+#define ARTEMIS_FIRMWARE_TASKFACE_H
+
+#include "LV_Interface/LVObject.h"
+#include <cstdint>
+
+// Watch face drawn over the lock screen: task icon, big time, date, current task (large)
+// and the next one with its start time. The background takes the current task's color.
+class TaskFace : public LVObject {
+public:
+	explicit TaskFace(lv_obj_t* parent);
+	void loop();
+
+private:
+	void refresh(int64_t now);
+
+	lv_obj_t* bgTarget;
+	lv_obj_t* icon;
+	lv_obj_t* time;
+	lv_obj_t* date;
+	lv_obj_t* line1;
+	lv_obj_t* current;
+	lv_obj_t* line2;
+	lv_obj_t* next;
+
+	uint32_t shownRev = 0;
+	int64_t shownMinute = -1;
+};
+
+#endif //ARTEMIS_FIRMWARE_TASKFACE_H
