@@ -0,0 +1,117 @@
+#include "TaskFace.h"
+#include "Calendar/CalendarStore.h"
+#include "Calendar/CalendarUi.h"
+#include "Calendar/TaskIcons.h"
+#include "Theme/theme.h"
+#include <cctype>
+#include <cstdio>
+
+static lv_obj_t* makeLabel(lv_obj_t* parent, const lv_font_t* font, int y){
+	auto l = lv_label_create(parent);
+	lv_obj_set_style_text_font(l, font, 0);
+	lv_obj_set_style_text_align(l, LV_TEXT_ALIGN_CENTER, 0);
+	lv_obj_set_width(l, 120);
+	lv_obj_align(l, LV_ALIGN_TOP_MID, 0, y);
+	lv_label_set_long_mode(l, LV_LABEL_LONG_DOT);
+	lv_label_set_text(l, "");
+	return l;
+}
+
+static lv_obj_t* makeLine(lv_obj_t* parent, int y){
+	auto l = lv_obj_create(parent);
+	lv_obj_set_size(l, 104, 1);
+	lv_obj_align(l, LV_ALIGN_TOP_MID, 0, y);
+	lv_obj_set_style_border_width(l, 0, 0);
+	lv_obj_set_style_radius(l, 0, 0);
+	lv_obj_set_style_bg_opa(l, LV_OPA_COVER, 0);
+	return l;
+}
+
+TaskFace::TaskFace(lv_obj_t* parent) : LVObject(parent), bgTarget(parent){
+	lv_obj_set_size(*this, 128, 128);
+	lv_obj_set_pos(*this, 0, 0);
+	lv_obj_set_style_bg_opa(*this, LV_OPA_TRANSP, 0);
+	lv_obj_set_style_border_width(*this, 0, 0);
+	lv_obj_set_style_pad_all(*this, 0, 0);
+	lv_obj_clear_flag(*this, LV_OBJ_FLAG_SCROLLABLE);
+	lv_obj_move_background(*this);   // battery / phone indicators stay on top
+
+	icon = lv_img_create(*this);
+	lv_obj_align(icon, LV_ALIGN_TOP_MID, 0, 13);
+
+	time = makeLabel(*this, &facetime36, 27);
+	date = makeLabel(*this, &taskfont12, 51);
+	line1 = makeLine(*this, 64);
+	current = makeLabel(*this, &taskfont20, 68);
+	lv_label_set_long_mode(current, LV_LABEL_LONG_SCROLL_CIRCULAR);   // long names scroll
+	line2 = makeLine(*this, 87);
+	next = makeLabel(*this, &taskfont12, 90);
+
+	// first loop() paints it; LockSkin sets main's default bg after constructing us
+}
+
+void TaskFace::loop(){
+	const int64_t now = calNowLocal();
+	if(now / 60 != shownMinute || CalendarStore::get().revision() != shownRev){
+		refresh(now);
+	}
+}
+
+void TaskFace::refresh(int64_t now){
+	auto& store = CalendarStore::get();
+	shownRev = store.revision();
+	shownMinute = now / 60;
+
+	const auto cur = store.current(now);
+	std::optional<CalEvent> nxt;
+	for(const auto& e : store.upcoming(now, 12)){
+		if(!e.allDay && !e.cancelled && e.start > now){ nxt = e; break; }
+	}
+
+	const uint32_t rgb = cur ? cur->color : 0;
+	const lv_color_t fg = taskFg(rgb);
+	lv_obj_set_style_bg_color(bgTarget, taskBg(rgb), 0);
+	lv_obj_set_style_bg_opa(bgTarget, LV_OPA_COVER, 0);
+
+	for(auto l : { time, date, current, next }) lv_obj_set_style_text_color(l, fg, 0);
+	for(auto l : { line1, line2 }) lv_obj_set_style_bg_color(l, fg, 0);
+
+	char buf[64];
+	const time_t t = (time_t) now;
+	tm tmv = {};
+	gmtime_r(&t, &tmv);
+	strftime(buf, sizeof(buf), "%H:%M", &tmv);
+	lv_label_set_text(time, buf);
+	strftime(buf, sizeof(buf), "%a %d %b", &tmv);
+	for(char* c = buf; *c; c++) *c = (char) toupper((unsigned char) *c);
+	lv_label_set_text(date, buf);
+
+	const lv_img_dsc_t* img = cur ? task_icon(cur->icon) : nullptr;
+	if(img != nullptr){
+		lv_img_set_src(icon, img);
+		lv_obj_set_style_img_recolor(icon, fg, 0);
+		lv_obj_set_style_img_recolor_opa(icon, LV_OPA_COVER, 0);
+		lv_obj_clear_flag(icon, LV_OBJ_FLAG_HIDDEN);
+	}else{
+		lv_obj_add_flag(icon, LV_OBJ_FLAG_HIDDEN);
+	}
+
+	lv_label_set_text(current, cur ? cur->title.c_str() : "Free time");
+	lv_obj_set_style_text_opa(current, cur ? LV_OPA_COVER : LV_OPA_60, 0);
+
+	if(nxt){
+		const time_t s = (time_t) nxt->start;
+		tm ts = {};
+		gmtime_r(&s, &ts);
+		if(ts.tm_yday == tmv.tm_yday && ts.tm_year == tmv.tm_year){
+			snprintf(buf, sizeof(buf), "%02d:%02d %s", ts.tm_hour, ts.tm_min, nxt->title.c_str());
+		}else{
+			char day[8];
+			strftime(day, sizeof(day), "%a", &ts);
+			snprintf(buf, sizeof(buf), "%s %02d:%02d %s", day, ts.tm_hour, ts.tm_min, nxt->title.c_str());
+		}
+		lv_label_set_text(next, buf);
+	}else{
+		lv_label_set_text(next, "");
+	}
+}
