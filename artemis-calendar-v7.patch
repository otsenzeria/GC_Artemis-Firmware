+#include <cstdio>
+
+static lv_obj_t* glyph(lv_obj_t* parent, const lv_img_dsc_t* img, lv_color_t c){
+	auto i = lv_img_create(parent);
+	lv_img_set_src(i, img);
+	lv_obj_set_style_img_recolor(i, c, 0);
+	lv_obj_set_style_img_recolor_opa(i, LV_OPA_COVER, 0);
+	lv_obj_center(i);
+	return i;
+}
+
+TaskAlertScreen::TaskAlertScreen(CalEvent e) : event(std::move(e)), queue(4){
+	fg = taskFg(event.color);
+	lv_obj_set_size(*this, 128, 128);
+	lv_obj_set_style_bg_color(*this, taskBg(event.color), 0);
+	lv_obj_set_style_bg_opa(*this, LV_OPA_COVER, 0);
+	lv_obj_clear_flag(*this, LV_OBJ_FLAG_SCROLLABLE);
+
+	if(const auto* img = task_icon(event.icon)){
+		auto icon = lv_img_create(*this);
+		lv_img_set_src(icon, img);
+		lv_img_set_zoom(icon, 512);   // 16 px art shown at 32 px
+		lv_obj_set_style_img_recolor(icon, fg, 0);
+		lv_obj_set_style_img_recolor_opa(icon, LV_OPA_COVER, 0);
+		lv_obj_align(icon, LV_ALIGN_TOP_MID, 0, 18);
+	}
+
+	auto title = lv_label_create(*this);
+	lv_obj_set_width(title, 120);
+	lv_obj_set_style_text_font(title, &taskfont20, 0);
+	lv_obj_set_style_text_color(title, fg, 0);
+	lv_obj_set_style_text_align(title, LV_TEXT_ALIGN_CENTER, 0);
+	lv_label_set_long_mode(title, LV_LABEL_LONG_WRAP);
+	lv_label_set_text(title, event.title.c_str());
+	lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 44);
+
+	clock = lv_label_create(*this);
+	lv_obj_set_style_text_font(clock, &taskfont12, 0);
+	lv_obj_set_style_text_color(clock, fg, 0);
+	lv_obj_align(clock, LV_ALIGN_TOP_MID, 0, 82);
+
+	for(int i = 0; i < 2; i++){
+		boxes[i] = lv_obj_create(*this);
+		lv_obj_set_size(boxes[i], 30, 26);
+		lv_obj_align(boxes[i], LV_ALIGN_BOTTOM_MID, i == 0 ? -26 : 26, -4);
+		lv_obj_set_style_bg_opa(boxes[i], LV_OPA_TRANSP, 0);
+		lv_obj_set_style_border_color(boxes[i], fg, 0);
+		lv_obj_set_style_radius(boxes[i], 4, 0);
+		lv_obj_set_style_pad_all(boxes[i], 0, 0);
+		lv_obj_clear_flag(boxes[i], LV_OBJ_FLAG_SCROLLABLE);
+	}
+	glyph(boxes[0], task_icon_check(), fg);
+	glyph(boxes[1], task_icon_cross(), fg);
+	select(0);
+}
+
+TaskAlertScreen::~TaskAlertScreen() = default;
+
+void TaskAlertScreen::onStart(){
+	Events::listen(Facility::Input, &queue);
+}
+
+void TaskAlertScreen::onStop(){
+	Events::unlisten(&queue);
+}
+
+void TaskAlertScreen::select(int opt){
+	option = opt;
+	for(int i = 0; i < 2; i++){
+		lv_obj_set_style_border_width(boxes[i], i == option ? 2 : 0, 0);
+	}
+}
+
+void TaskAlertScreen::removeNotif(){
+	if(auto phone = (Phone*) Services.get(Service::Phone)){
+		phone->doNeg(Phone::LocalNotifBit | (event.id & ~Phone::LocalNotifBit));
+	}
+}
+
+void TaskAlertScreen::finish(bool cancelled){
+	removeNotif();
+	if(CalendarStore::get().setStatus(event.id, cancelled)){
+		if(auto phone = (Phone*) Services.get(Service::Phone)) phone->calendarFlush();
+	}
+	transition([](){ return std::make_unique<LockScreen>(); });
+}
+
+void TaskAlertScreen::dismiss(){
+	removeNotif();
+	if(auto sleep = (SleepMan*) Services.get(Service::Sleep)) sleep->requestSleep();
+}
+
+void TaskAlertScreen::loop(){
+	const int64_t now = calNowLocal();
+	if(now / 60 != shownMinute){
+		shownMinute = now / 60;
+		const time_t t = (time_t) now;
+		tm tmv = {};
+		gmtime_r(&t, &tmv);
+		char buf[8];
+		strftime(buf, sizeof(buf), "%H:%M", &tmv);
+		lv_label_set_text(clock, buf);
+	}
+
+	Event evt{};
+	if(!queue.get(evt, 0)) return;
+	if(evt.facility != Facility::Input){
+		free(evt.data);
+		return;
+	}
+	auto data = (Input::Data*) evt.data;
+	const bool press = data->action == Input::Data::Press;
+	const auto btn = data->btn;
+	free(evt.data);
+	if(!press) return;
+
+	switch(btn){
+		case Input::Up:
+		case Input::Down:
+			select(1 - option);
+			break;
+		case Input::Select:
+			finish(option == 1);
+			break;
+		case Input::Alt:
+			dismiss();
+			break;
+	}
+}
