+void Android::handleCalAdd(const std::vector<std::string>& split_line){
+	CalEvent ev;
+	ev.id = (uint32_t) std::stoul(split_line[1]);
+	ev.start = std::stoll(split_line[2]);
+	ev.end = std::stoll(split_line[3]);
+	ev.allDay = split_line[4] == "1";
+	ev.title = split_line[5];
+	ev.location = split_line[6];
+	ev.remindMin = split_line.size() >= 8 ? (int16_t) std::stoi(split_line[7]) : -1;
+	if(split_line.size() >= 11){
+		ev.icon = (uint8_t) std::stoul(split_line[8]);
+		ev.color = (uint32_t) std::stoul(split_line[9]);
+		ev.cancelled = split_line[10] == "1";
+	}
+	CalendarStore::get().stage(ev);
+}
+
+// tplAdd;<id>;<durationMin>;<title>
+void Android::handleTplAdd(const std::vector<std::string>& split_line){
+	TaskTemplate t;
+	t.id = (uint32_t) std::stoul(split_line[1]);
+	t.durationMin = (uint16_t) std::stoul(split_line[2]);
+	t.title = split_line[3];
+	if(split_line.size() >= 6){
+		t.icon = (uint8_t) std::stoul(split_line[4]);
+		t.color = (uint32_t) std::stoul(split_line[5]);
+	}
+	CalendarStore::get().stageTemplate(t);
+}
+
+// taskStart;<seq>;<localId>;<tplId>;<startLocal>   taskEnd;<seq>;<eventId>;<endLocal>   taskStatus;<seq>;<eventId>;<0|1>
+void Android::flushPending(){
+	if(!connected) return;
+	for(const auto& p : CalendarStore::get().pending()){
+		if(p.type == PendingAction::Type::Start){
+			uart.printf("taskStart;%lu;%lu;%lu;%lld\n", (unsigned long) p.seq, (unsigned long) p.eventId, (unsigned long) p.tplId, (long long) p.time);
+		}else if(p.type == PendingAction::Type::End){
+			uart.printf("taskEnd;%lu;%lu;%lld\n", (unsigned long) p.seq, (unsigned long) p.eventId, (long long) p.time);
+		}else{
+			uart.printf("taskStatus;%lu;%lu;%u\n", (unsigned long) p.seq, (unsigned long) p.eventId, (unsigned) p.status);
+		}
+	}
+}
