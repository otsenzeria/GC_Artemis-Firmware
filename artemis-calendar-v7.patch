+class TaskAlertScreen : public LVScreen {
+public:
+	explicit TaskAlertScreen(CalEvent event);
+	~TaskAlertScreen() override;
+
+private:
+	void onStart() override;
+	void onStop() override;
+	void loop() override;
+
+	void select(int option);
+	void finish(bool cancelled);
+	void dismiss();
+	void removeNotif();
+
+	CalEvent event;
+	EventQueue queue;
+	lv_obj_t* clock;
+	lv_obj_t* boxes[2];
+	int option = 0;          // 0 = ✓ done, 1 = ✗ cancel
+	int64_t shownMinute = -1;
+	lv_color_t fg;
+};
+
+#endif //ARTEMIS_FIRMWARE_TASKALERTSCREEN_H
