+#ifndef ARTEMIS_FIRMWARE_AGENDASCREEN_H
+#define ARTEMIS_FIRMWARE_AGENDASCREEN_H
+
+#include "LV_Interface/LVScreen.h"
+#include "Util/Events.h"
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// Agenda:     wheel = scroll, click = actions, power button = back to menu
+// Actions:    "Start task..." / "Finish: <current>" / "Sync with phone"
+// Templates:  task presets defined on the phone; click starts one now
+class AgendaScreen : public LVScreen {
+public:
+	AgendaScreen();
+	~AgendaScreen() override;
+
+private:
+	enum class Mode { Agenda, Actions, Templates };
+	enum class Action { StartTask, Finish, Cancel, Sync };
+
+	void onStart() override;
+	void onStop() override;
+	void loop() override;
+
+	void showAgenda(int64_t now);
+	void showActions();
+	void showTemplates();
+	void showMenu(const char* title, const std::vector<std::string>& items);
+	void moveSelection(int delta);
+	void activate();
+	void onButton(uint8_t btn);
+
+	lv_obj_t* addLabel(const char* text, lv_color_t color);
+
+	EventQueue queue;
+	lv_obj_t* header;
+	lv_obj_t* list;
+
+	Mode mode = Mode::Agenda;
+	std::vector<lv_obj_t*> rows;
+	std::vector<Action> actions;
+	std::vector<uint32_t> templateIds;
+	int selected = 0;
+
+	uint32_t shownRev = 0;
+	int64_t shownMinute = -1;
+
+	static constexpr size_t MaxShown = 20;
+	static constexpr int16_t ScrollStep = 24;
+};
+
+#endif //ARTEMIS_FIRMWARE_AGENDASCREEN_H
