@@ -0,0 +1,31 @@
+#ifndef ARTEMIS_FIRMWARE_CALENDARUI_H
+#define ARTEMIS_FIRMWARE_CALENDARUI_H
+
+#include "Services/Time.h"
+#include "Util/Services.h"
+#include <lvgl.h>
+#include <cstdint>
+#include <ctime>
+
+// The Time service keeps "local epoch" and the device TZ is UTC,
+// so mktime() is the exact inverse of the gmtime_r() it uses.
+inline int64_t calNowLocal(){
+	auto ts = (Time*) Services.get(Service::Time);
+	if(ts == nullptr) return 0;
+	tm t = ts->getTime();
+	return (int64_t) mktime(&t);
+}
+
+inline lv_color_t taskBg(uint32_t rgb){
+	if(rgb == 0) return lv_color_make(0x18, 0x18, 0x20);
+	return lv_color_make((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+// Black text on light task colors, white on dark ones
+inline lv_color_t taskFg(uint32_t rgb){
+	if(rgb == 0) return lv_color_white();
+	const uint32_t r = (rgb >> 16) & 0xff, g = (rgb >> 8) & 0xff, b = rgb & 0xff;
+	return (r * 299 + g * 587 + b * 114) / 1000 > 150 ? lv_color_black() : lv_color_white();
+}
+
+#endif //ARTEMIS_FIRMWARE_CALENDARUI_H
